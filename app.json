{
  "expo": {
    "name": "Heartline",
    "slug": "heartline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heartline",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heartline.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Heartline precisa de acesso à câmara para fotografar os teus exames clínicos.",
        "NSPhotoLibraryUsageDescription": "O Heartline precisa de acesso à galeria para importar fotos ou PDFs dos teus exames."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.heartline.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Heartline usa dados do Apple Health para complementar a tua visão de saúde cardiovascular, incluindo frequência cardíaca, pressão arterial e atividade física.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    }
  }
}
